[global]
    monitor = 0
    follow = mouse

    width = (320, 480)
    height = (0, 500)
    origin = top-right
    offset = (16, 16)
    notification_limit = 5

    transparency = 0
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    separator_height = 1
    separator_color = frame

    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 0
    corners = all

    font = "Sans 12"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60
    show_indicators = yes
    stack_duplicates = true
    hide_duplicate_count = false
    sort = yes

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#292c35"
    foreground = "#a6adc8"
    frame_color = "#6c7086"
    timeout = 5

[urgency_normal]
    background = "#292c35"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8

[urgency_critical]
    background = "#292c35"
    foreground = "#f2cdcd"
    frame_color = "#f38ba8"
    timeout = 0
